# GripIt runs scan fitting and rule-based feedback on the device.
# Real Step 3 photo reading uses a server-only Perceptron credential.
# Never put this key in Xcode, the app bundle or VITE_ variables.
PERCEPTRON_API_KEY=
# Local helper defaults to loopback. Set 0.0.0.0 explicitly for an iPhone on Wi-Fi.
GRIPIT_PHOTO_HOST=127.0.0.1
GRIPIT_PHOTO_PORT=5173
